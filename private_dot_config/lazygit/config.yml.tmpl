{{- $t := index .themes .theme -}}
{{- $p := $t.palette -}}
# base16 theme: {{ $t.name }}
# Auto-generated by chezmoi from .chezmoidata/theme.yaml — do not edit directly.
# To change theme: run `theme-switch`.

gui:
  screenMode: half
  colorScheme: {{ $t.variant }}
  theme:
    # Navigation and focus
    activeBorderColor:
      - '{{ $p.base0B }}'
      - bold
    inactiveBorderColor:
      - '{{ $p.base03 }}'
    searchingActiveBorderColor:
      - '{{ $p.base0C }}'
      - bold
    optionsTextColor:
      - '{{ $p.base0D }}'

    # The selected text color is explicit so it cannot match the background.
    selectedLineFgColor:
      - '{{ $p.base05 }}'
      - bold
    selectedLineBgColor:
      - '{{ $p.base02 }}'
    inactiveViewSelectedLineBgColor:
      - '{{ $p.base01 }}'

    # Git state
    cherryPickedCommitFgColor:
      - '{{ $p.base00 }}'
    cherryPickedCommitBgColor:
      - '{{ $p.base0C }}'
    markedBaseCommitFgColor:
      - '{{ $p.base00 }}'
    markedBaseCommitBgColor:
      - '{{ $p.base0A }}'
    unstagedChangesColor:
      - '{{ $p.base08 }}'
    defaultFgColor:
      - '{{ $p.base05 }}'

os:
  openLink: /usr/bin/open {{ "{{link}}" }}
