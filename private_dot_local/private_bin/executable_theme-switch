#!/usr/bin/env bash
set -euo pipefail

die() { printf 'theme-switch: %s\n' "$*" >&2; exit 1; }

command -v chezmoi >/dev/null || die 'chezmoi is required'
command -v jq >/dev/null || die 'jq is required'

source_dir=$(chezmoi source-path)
theme_file=$source_dir/.chezmoidata/theme.yaml
data=$(chezmoi data --format=json) || die 'could not read chezmoi theme data'
current=$(jq -r '.theme' <<<"$data")

paint() {
  local bg=${1#\#} fg=${2#\#}
  printf '\033[48;2;%d;%d;%dm\033[38;2;%d;%d;%dm%s\033[0m' \
    "$((16#${bg:0:2}))" "$((16#${bg:2:2}))" "$((16#${bg:4:2}))" \
    "$((16#${fg:0:2}))" "$((16#${fg:2:2}))" "$((16#${fg:4:2}))" "$3"
}

swatch() {
  local hex=${1#\#}
  printf '\033[48;2;%d;%d;%dm        \033[0m %s' \
    "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))" "$1"
}

preview_theme() {
  local row name variant
  row=$(jq -er --arg id "$1" '.themes[$id] | select(.) | [.name, .variant, (.palette | .base00, .base01, .base02, .base03, .base04, .base05, .base06, .base07, .base08, .base09, .base0A, .base0B, .base0C, .base0D, .base0E, .base0F)] | @tsv' <<<"$data") || die "unknown theme: $1"
  local base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F
  IFS=$'\t' read -r name variant base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F <<<"$row"
  local palette=("$base00" "$base01" "$base02" "$base03" "$base04" "$base05" "$base06" "$base07" "$base08" "$base09" "$base0A" "$base0B" "$base0C" "$base0D" "$base0E" "$base0F")
  local keys=(base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F)
  local i

  printf '\n  %s  ·  %s\n\n' "$name" "$variant"
  paint "$base00" "$base05" '  Normal text on editor background       '
  printf '\n'
  paint "$base02" "$base05" '  Selected text                          '
  printf '\n'
  paint "$base00" "$base0E" '  local '
  paint "$base00" "$base0D" 'theme'
  paint "$base00" "$base05" ' = '
  paint "$base00" "$base0B" '"colors"'
  printf '\n\n'

  for ((i = 0; i < 8; i++)); do
    printf '  %-6s ' "${keys[i]}"
    swatch "${palette[i]}"
    printf '    %-6s ' "${keys[i + 8]}"
    swatch "${palette[i + 8]}"
    printf '\n'
  done
}

case ${1:-} in
  --preview)
    [[ $# == 2 ]] || die 'usage: theme-switch --preview THEME_ID'
    preview_theme "$2"
    ;;
  --current)
    [[ $# == 1 ]] || die 'usage: theme-switch [--list | --current | --set THEME_ID]'
    printf '%s\n' "$current"
    ;;
  --list)
    [[ $# == 1 ]] || die 'usage: theme-switch [--list | --current | --set THEME_ID]'
    jq -r --arg current "$current" '.themes | to_entries | sort_by(.key)[] | [.key, .value.name, .value.variant, (if .key == $current then "*" else "" end)] | @tsv' <<<"$data"
    ;;
  --set|'')
    if [[ ${1:-} == --set ]]; then
      [[ $# == 2 ]] || die 'usage: theme-switch --set THEME_ID'
      selected=$2
    else
      [[ $# == 0 ]] || die 'usage: theme-switch [--list | --current | --set THEME_ID]'
      command -v fzf >/dev/null || die 'fzf is required for the interactive picker'
      choices=$(jq -r --arg current "$current" '.themes | to_entries | sort_by(.key)[] | (if .key == $current then "●" else " " end) + "\t" + .key + "\t" + .value.name + " (" + .value.variant + ")"' <<<"$data")
      picked=$(fzf --delimiter=$'\t' --with-nth=1,3 --prompt='Theme> ' \
        --preview 'theme-switch --preview {2}' \
        --preview-window 'right,55%,border-left,<90(up,60%,border-bottom)' \
        <<<"$choices") || exit 0
      [[ -n $picked ]] || exit 0
      selected=$(cut -f2 <<<"$picked")
    fi

    jq -e --arg id "$selected" '.themes | has($id)' <<<"$data" >/dev/null || die "unknown theme: $selected"
    [[ $selected != "$current" ]] || exit 0

    tmp=$(mktemp "$theme_file.XXXXXX") || die 'could not create temporary theme file'
    trap 'rm -f "$tmp"' EXIT
    awk -v theme="$selected" '/^theme:/ { print "theme: " theme; found=1; next } { print } END { if (!found) exit 1 }' "$theme_file" >"$tmp" || die "could not update $theme_file"
    chmod 644 "$tmp"
    mv "$tmp" "$theme_file" || die "could not save $theme_file"

    target_dir=$(chezmoi target-path)
    if ! chezmoi apply --force --parent-dirs \
      "$target_dir/.config/ghostty/themes/base16" \
      "$target_dir/.config/vivid/themes/base16.yml" \
      "$target_dir/.local/share/nvim/base16-colors.lua" \
      "$target_dir/.config/btop/themes/base16.theme"; then
      die 'chezmoi apply failed; theme selection was saved but apps were not reloaded'
    fi

    case $(uname -s) in
      Darwin)
        osascript -e 'if application "Ghostty" is running then' \
          -e 'tell application "Ghostty"' \
          -e 'repeat with t in terminals' \
          -e 'perform action "reload_config" on t' \
          -e 'end repeat' \
          -e 'end tell' \
          -e 'end if' >/dev/null || die 'Ghostty reload failed; check macOS Automation permission for Ghostty'
        ;;
      Linux)
        systemctl reload --user app-com.mitchellh.ghostty.service || die 'Ghostty reload failed; launch Ghostty through its systemd user service (app-com.mitchellh.ghostty.service)'
        ;;
    esac
    printf 'Theme: %s\n' "$selected"
    ;;
  *) die 'usage: theme-switch [--list | --current | --set THEME_ID]' ;;
esac
