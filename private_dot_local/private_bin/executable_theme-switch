#!/usr/bin/env bash
set -euo pipefail

readonly PROGRAM=${0##*/}
readonly USAGE="usage: $PROGRAM [--list | --current | --set THEME_ID]"

die() {
  printf '%s: %s\n' "$PROGRAM" "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null || die "$1 is required"
}

require_command chezmoi
require_command jq

SOURCE_DIR=$(chezmoi source-path) || die 'could not find the chezmoi source directory'
TARGET_DIR=$(chezmoi target-path) || die 'could not find the chezmoi target directory'
DATA=$(chezmoi data --format=json) || die 'could not read chezmoi theme data'
CURRENT_THEME=$(jq -er '.theme' <<<"$DATA") || die 'could not read the current theme'
PLATFORM=$(uname -s)

readonly SOURCE_DIR
readonly TARGET_DIR
readonly THEME_FILE=$SOURCE_DIR/.chezmoidata/theme.yaml
readonly PLATFORM
readonly DATA
readonly CURRENT_THEME

theme_exists() {
  jq -e --arg id "$1" '.themes | has($id)' <<<"$DATA" >/dev/null
}

theme_variant() {
  jq -r --arg id "$1" '.themes[$id].variant' <<<"$DATA"
}

list_themes() {
  jq -r --arg current "$CURRENT_THEME" '
    .themes
    | to_entries
    | sort_by(.key)[]
    | [
        .key,
        .value.name,
        .value.variant,
        (if .key == $current then "*" else "" end)
      ]
    | @tsv
  ' <<<"$DATA"
}

picker_rows() {
  jq -r --arg current "$CURRENT_THEME" '
    .themes
    | to_entries
    | sort_by(.key)[]
    | (if .key == $current then "●" else " " end)
        + "\t" + .key
        + "\t" + .value.name + " (" + .value.variant + ")"
  ' <<<"$DATA"
}

paint() {
  local background=${1#\#}
  local foreground=${2#\#}
  local text=$3

  printf '\033[48;2;%d;%d;%dm\033[38;2;%d;%d;%dm%s\033[0m' \
    "$((16#${background:0:2}))" \
    "$((16#${background:2:2}))" \
    "$((16#${background:4:2}))" \
    "$((16#${foreground:0:2}))" \
    "$((16#${foreground:2:2}))" \
    "$((16#${foreground:4:2}))" \
    "$text"
}

swatch() {
  local color=${1#\#}

  printf '\033[48;2;%d;%d;%dm        \033[0m %s' \
    "$((16#${color:0:2}))" \
    "$((16#${color:2:2}))" \
    "$((16#${color:4:2}))" \
    "$1"
}

preview_theme() {
  local theme_id=$1
  local record name variant
  local base00 base01 base02 base03 base04 base05 base06 base07
  local base08 base09 base0A base0B base0C base0D base0E base0F

  record=$(jq -er --arg id "$theme_id" '
    .themes[$id]
    | select(.)
    | [
        .name,
        .variant,
        (.palette | .base00, .base01, .base02, .base03,
                    .base04, .base05, .base06, .base07,
                    .base08, .base09, .base0A, .base0B,
                    .base0C, .base0D, .base0E, .base0F)
      ]
    | @tsv
  ' <<<"$DATA") || die "unknown theme: $theme_id"

  IFS=$'\t' read -r \
    name variant \
    base00 base01 base02 base03 base04 base05 base06 base07 \
    base08 base09 base0A base0B base0C base0D base0E base0F \
    <<<"$record"

  local palette=(
    "$base00" "$base01" "$base02" "$base03"
    "$base04" "$base05" "$base06" "$base07"
    "$base08" "$base09" "$base0A" "$base0B"
    "$base0C" "$base0D" "$base0E" "$base0F"
  )
  local keys=(
    base00 base01 base02 base03 base04 base05 base06 base07
    base08 base09 base0A base0B base0C base0D base0E base0F
  )

  printf '\n  %s  ·  %s\n\n' "$name" "$variant"
  paint "$base00" "$base05" '  Normal text on editor background       '
  printf '\n'
  paint "$base02" "$base05" '  Selected text                          '
  printf '\n'
  paint "$base00" "$base0E" '  local '
  paint "$base00" "$base0D" 'theme'
  paint "$base00" "$base05" ' = '
  paint "$base00" "$base0B" '"colors"'
  printf '\n\n'

  local index
  for ((index = 0; index < 8; index++)); do
    printf '  %-6s ' "${keys[index]}"
    swatch "${palette[index]}"
    printf '    %-6s ' "${keys[index + 8]}"
    swatch "${palette[index + 8]}"
    printf '\n'
  done
}

choose_theme() {
  require_command fzf

  local picked
  picked=$(picker_rows | fzf \
    --delimiter=$'\t' \
    --with-nth=1,3 \
    --prompt='Theme> ' \
    --preview "$PROGRAM --preview {2}" \
    --preview-window='right,55%,border-left,<90(up,60%,border-bottom)') || return 1

  [[ -n $picked ]] || return 1
  cut -f2 <<<"$picked"
}

save_theme() {
  local theme_id=$1
  local temporary_file

  temporary_file=$(mktemp "$THEME_FILE.XXXXXX") || die 'could not create temporary theme file'
  if ! awk -v theme="$theme_id" '
    /^theme:/ {
      print "theme: " theme
      found = 1
      next
    }
    { print }
    END { if (!found) exit 1 }
  ' "$THEME_FILE" >"$temporary_file"; then
    rm -f "$temporary_file"
    die "could not update $THEME_FILE"
  fi

  if ! chmod 644 "$temporary_file" || ! mv "$temporary_file" "$THEME_FILE"; then
    rm -f "$temporary_file"
    die "could not save $THEME_FILE"
  fi
}

apply_theme_files() {
  local targets=(
    "$TARGET_DIR/.config/ghostty/themes/base16"
    "$TARGET_DIR/.config/vivid/themes/base16.yml"
    "$TARGET_DIR/.config/lsd/colors.yaml"
    "$TARGET_DIR/.local/share/nvim/base16-colors.lua"
    "$TARGET_DIR/.config/btop/themes/base16.theme"
    "$TARGET_DIR/.config/lazygit/config.yml"
  )

  if [[ $PLATFORM == Linux ]]; then
    targets+=(
      "$TARGET_DIR/.config/noctalia/config.toml"
      "$TARGET_DIR/.config/noctalia/palettes/Base16.json"
      "$TARGET_DIR/.config/niri/noctalia.kdl"
    )
  fi

  chezmoi apply --force --parent-dirs "${targets[@]}" ||
    die 'chezmoi apply failed; the selection was saved but theme files were not updated'
}

persist_noctalia_theme() {
  local variant=$1
  local state_home=${XDG_STATE_HOME:-${HOME:?}/.local/state}
  local settings=$state_home/noctalia/settings.toml
  local temporary_file

  # Noctalia's state overrides config.toml after its first launch. Keep the
  # theme-owned keys in that state synchronized when Noctalia is not running.
  [[ -f $settings ]] || return 0
  temporary_file=$(mktemp "$settings.XXXXXX") || return 1

  if ! awk -v mode="$variant" '
    function add_missing_theme_keys() {
      if (!source_seen)  print "source = \"custom\""
      if (!palette_seen) print "custom_palette = \"Base16\""
      if (!mode_seen)    print "mode = \"" mode "\""
    }

    /^\[theme\]$/ {
      if (in_theme) add_missing_theme_keys()
      in_theme = 1
      found_theme = 1
      source_seen = palette_seen = mode_seen = 0
      print
      next
    }

    /^\[/ {
      if (in_theme) add_missing_theme_keys()
      in_theme = 0
    }

    in_theme && /^[[:space:]]*source[[:space:]]*=/ {
      print "source = \"custom\""
      source_seen = 1
      next
    }

    in_theme && /^[[:space:]]*custom_palette[[:space:]]*=/ {
      print "custom_palette = \"Base16\""
      palette_seen = 1
      next
    }

    in_theme && /^[[:space:]]*mode[[:space:]]*=/ {
      print "mode = \"" mode "\""
      mode_seen = 1
      next
    }

    { print }

    END {
      if (in_theme) add_missing_theme_keys()
      if (!found_theme) {
        print ""
        print "[theme]"
        print "source = \"custom\""
        print "custom_palette = \"Base16\""
        print "mode = \"" mode "\""
      }
    }
  ' "$settings" >"$temporary_file"; then
    rm -f "$temporary_file"
    return 1
  fi

  if ! chmod --reference="$settings" "$temporary_file" ||
    ! mv "$temporary_file" "$settings"; then
    rm -f "$temporary_file"
    return 1
  fi
}

reload_ghostty_on_macos() {
  osascript \
    -e 'if application "Ghostty" is running then' \
    -e 'tell application "Ghostty"' \
    -e 'repeat with t in terminals' \
    -e 'perform action "reload_config" on t' \
    -e 'end repeat' \
    -e 'end tell' \
    -e 'end if' \
    >/dev/null || die 'Ghostty reload failed; check macOS Automation permission for Ghostty'
}

reload_noctalia() {
  local variant=$1

  if command -v noctalia >/dev/null && noctalia msg status >/dev/null 2>&1; then
    noctalia msg color-scheme-set custom Base16 >/dev/null ||
      die 'Noctalia palette reload failed'
    noctalia msg theme-mode-set "$variant" >/dev/null ||
      die 'Noctalia theme mode reload failed'
  else
    persist_noctalia_theme "$variant" ||
      die 'could not persist the Noctalia theme selection'
  fi
}

reload_niri() {
  # Noctalia can overwrite this include while changing palettes. Restore the
  # managed version before asking Niri to reload its configuration.
  chezmoi apply --force --parent-dirs "$TARGET_DIR/.config/niri/noctalia.kdl" ||
    die 'could not restore the managed Niri theme'

  if command -v niri >/dev/null && niri msg version >/dev/null 2>&1; then
    niri msg action load-config-file >/dev/null || die 'Niri theme reload failed'
  fi
}

reload_ghostty_on_linux() {
  command -v pgrep >/dev/null || return 0

  local ghostty_pid
  local ghostty_pids=()
  mapfile -t ghostty_pids < <(pgrep -u "$UID" -x ghostty || true)

  for ghostty_pid in "${ghostty_pids[@]}"; do
    kill -USR2 "$ghostty_pid" 2>/dev/null ||
      [[ ! -e /proc/$ghostty_pid ]] ||
      die "Ghostty reload failed for process $ghostty_pid"
  done
}

reload_apps() {
  local theme_id=$1

  case $PLATFORM in
    Darwin)
      reload_ghostty_on_macos
      ;;
    Linux)
      reload_noctalia "$(theme_variant "$theme_id")"
      reload_niri
      reload_ghostty_on_linux
      ;;
  esac
}

switch_theme() {
  local theme_id=$1

  theme_exists "$theme_id" || die "unknown theme: $theme_id"
  save_theme "$theme_id"
  apply_theme_files
  reload_apps "$theme_id"
  printf 'Theme: %s\n' "$theme_id"
}

main() {
  case ${1:-} in
    --preview)
      [[ $# == 2 ]] || die "usage: $PROGRAM --preview THEME_ID"
      preview_theme "$2"
      ;;
    --current)
      [[ $# == 1 ]] || die "$USAGE"
      printf '%s\n' "$CURRENT_THEME"
      ;;
    --list)
      [[ $# == 1 ]] || die "$USAGE"
      list_themes
      ;;
    --set)
      [[ $# == 2 ]] || die "usage: $PROGRAM --set THEME_ID"
      switch_theme "$2"
      ;;
    '')
      [[ $# == 0 ]] || die "$USAGE"
      local selected
      selected=$(choose_theme) || exit 0
      switch_theme "$selected"
      ;;
    *)
      die "$USAGE"
      ;;
  esac
}

main "$@"
